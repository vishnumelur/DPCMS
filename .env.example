# Database — Neon free tier (aws-ap-south-1)
# Neon gives you two connection strings:
#   * POOLED   — host contains "-pooler"  → use for serverless runtime queries (Next.js routes, server actions)
#   * UNPOOLED — host has no "-pooler"    → use for migrations, seeds, and anything needing prepared statements / transactions / LISTEN-NOTIFY
# Both URLs should include `?sslmode=require`. Get them from Neon dashboard → Connection Details → "Connection pooling" toggle.
DATABASE_URL=postgres://user:pass@ep-host-pooler.aws-ap-south-1.neon.tech/dpcms?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-host.aws-ap-south-1.neon.tech/dpcms?sslmode=require

# NextAuth v5
AUTH_SECRET=  # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Email (Resend free tier)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=DPCMS <onboarding@resend.dev>

# Vercel AI Gateway (Gemini Flash free tier)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Cron
CRON_SECRET=  # openssl rand -hex 32

# Seed
SEED_ORG_NAME=Kerala State Cooperative Bank
SEED_ORG_SLUG=kscb
